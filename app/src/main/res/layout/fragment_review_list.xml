<?xml version="1.0" encoding="utf-8"?>
<!-- 本轮回顾列表 Fragment：答对数量 + 逐题答案 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <TextView
        android:id="@+id/reviewSummary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_home_icon"
        android:backgroundTint="@color/ls_primary_container"
        android:padding="@dimen/ls_card_pad"
        android:textAppearance="@style/TextAppearance.LS.Title"
        android:textColor="?attr/colorOnPrimaryContainer" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/ls_gap"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/answerList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="@dimen/ls_margin" />

        <TextView
            android:id="@+id/emptyState"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="@dimen/ls_section"
            android:text="@string/review_empty"
            android:textAppearance="@style/TextAppearance.LS.Body"
            android:textColor="@color/ls_muted"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
