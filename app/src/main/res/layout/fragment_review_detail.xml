<?xml version="1.0" encoding="utf-8"?>
<!-- 本轮回顾详情 Fragment：单题大字 + 所选/正确答案 + Previous/Next -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingBottom="@dimen/ls_margin">

        <com.littlestar.app.core.ui.HanziTextView
            android:id="@+id/detailHanzi"
            android:layout_width="@dimen/ls_cover"
            android:layout_height="@dimen/ls_cover"
            android:background="@drawable/bg_home_icon"
            android:backgroundTint="@color/ls_surface_container"
            android:gravity="center"
            android:minHeight="@dimen/ls_cover"
            android:textAppearance="@style/TextAppearance.LS.HanziHero" />

        <TextView
            android:id="@+id/detailPinyin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ls_gap"
            android:textAppearance="@style/TextAppearance.LS.Pinyin" />

        <TextView
            android:id="@+id/detailEnglish"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.LS.English" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ls_gap"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/detailStatus"
                android:layout_width="@dimen/ls_icon"
                android:layout_height="@dimen/ls_icon"
                android:contentDescription="@string/review_correct_desc" />

            <TextView
                android:id="@+id/detailAnswer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ls_gap_sm"
                android:textAppearance="@style/TextAppearance.LS.Body" />
        </LinearLayout>

        <com.littlestar.app.core.ui.LearningButton
            android:id="@+id/btnSpeak"
            style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
            android:layout_width="@dimen/ls_btn_icon"
            android:layout_height="@dimen/ls_btn_icon"
            android:layout_marginTop="@dimen/ls_gap"
            android:contentDescription="@string/player_desc_play"
            app:icon="@drawable/ic_speaker" />

        <TextView
            android:id="@+id/detailPosition"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ls_gap"
            android:textAppearance="@style/TextAppearance.LS.Caption"
            android:textColor="@color/ls_muted" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ls_gap"
            android:orientation="horizontal">

            <com.littlestar.app.core.ui.LearningButton
                android:id="@+id/btnPrev"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="@dimen/ls_btn_icon"
                android:text="@string/review_prev" />

            <com.littlestar.app.core.ui.LearningButton
                android:id="@+id/btnNext"
                style="@style/Widget.Material3.Button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ls_gap"
                android:layout_weight="1"
                android:minHeight="@dimen/ls_btn_icon"
                android:text="@string/review_next" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
