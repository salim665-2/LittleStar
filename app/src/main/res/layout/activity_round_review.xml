<?xml version="1.0" encoding="utf-8"?>
<!-- A1 本轮回顾（手机）：Activity 只做容器，列表/详情由 Fragment 切换 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/reviewRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ls_paper"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:maxWidth="@dimen/ls_content_max_width"
        android:orientation="vertical"
        android:padding="@dimen/ls_margin">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.littlestar.app.core.ui.LearningButton
                android:id="@+id/btnBack"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="@dimen/ls_btn_icon"
                android:layout_height="@dimen/ls_btn_icon"
                android:contentDescription="@string/nav_back"
                app:icon="@drawable/ic_back" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ls_gap"
                android:layout_weight="1"
                android:text="@string/review_title"
                android:textAppearance="@style/TextAppearance.LS.Title" />
        </LinearLayout>

        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/reviewPane"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/ls_gap"
            android:layout_weight="1" />
    </LinearLayout>
</LinearLayout>
